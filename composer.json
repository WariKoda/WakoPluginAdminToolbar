{
  "name": "wako/plugin-admin-toolbar",
  "description": "Admin Toolbar for Shopware Storefront",
  "type": "shopware-platform-plugin",
  "version": "2.0.0",
  "license": "MIT",
  "authors": [
    {
      "name": "WariKoda",
      "role": "Manufacturer"
    },
    {
      "name": "Niklas Braun",
      "role": "Lead Developer"
    }
  ],
  "require": {
    "shopware/administration": "~6.7.0",
    "shopware/core": "~6.7.0",
    "shopware/storefront": "~6.7.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "WakoPluginAdminToolbar\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WakoPluginAdminToolbar\\Tests\\Unit\\": "tests/unit/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse src --level=8 --memory-limit=1G",
    "test:unit": "phpunit -c phpunit.xml.dist"
  },
  "extra": {
    "shopware-plugin-class": "WakoPluginAdminToolbar\\WakoPluginAdminToolbar",
    "label": {
      "de-DE": "Admin Toolbar",
      "en-GB": "Admin Toolbar"
    }
  }
}
